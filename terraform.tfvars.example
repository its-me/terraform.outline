# Copy to terraform.tfvars and fill in your own values.

# IMPORTANT: this app depends on the shared infrastructure (network, Cloud SQL, Redis)
# in terraform.infrastructure. Destroy order: this repo (and every other app repo)
# FIRST, then terraform.infrastructure LAST.
#
# `terraform destroy` here can never delete the shared network/Cloud SQL/Redis
# instances themselves -- network.tf/postgresql.tf/redis.tf all hardcode create =
# false, which reads them back as data sources, not resources. The only things this
# repo can destroy are its own Cloud Run service, secrets, storage bucket, and its own
# database/user on the shared instance.

project_id = ""
region     = ""
domain     = ""

# At least one sign-in provider's credentials are required, otherwise Outline
# has no way for anyone to log in. See variable "auth_env" for details.
auth_env = {
  GOOGLE_CLIENT_ID     = ""
  GOOGLE_CLIENT_SECRET = ""
}

# Alternative: generic OIDC provider (e.g. Auth0). See
# https://docs.getoutline.com/s/hosting/doc/oidc-8CPBm6uC0I for details.
# auth_env = {
#   OIDC_CLIENT_ID      = ""
#   OIDC_CLIENT_SECRET  = ""
#   OIDC_AUTH_URI       = ""
#   OIDC_TOKEN_URI      = ""
#   OIDC_USERINFO_URI   = ""
#   OIDC_LOGOUT_URI     = "https://${domain}"
#   OIDC_USERNAME_CLAIM = "email"
#   OIDC_DISPLAY_NAME   = "Auth0"
#   OIDC_SCOPES         = "openid profile email"
# }

# Optional, defaults to 262144000 (250MiB).
# file_storage_upload_max_size = 262144000

# Optional. Without it, Outline sends no email (e.g. invites, notifications,
# password-reset links). See variable "smtp_env" and
# https://docs.getoutline.com/s/hosting/doc/smtp-cqCJyZGMIB for details.
# smtp_env = {
#   SMTP_SERVICE    = "" # or SMTP_HOST/SMTP_PORT instead, see docs
#   SMTP_USERNAME   = ""
#   SMTP_PASSWORD   = ""
#   SMTP_FROM_EMAIL = ""
# }

# Optional, defaults to `region` if unset.
# storage_bucket_location = ""

# Optional, defaults to "tools". Must match the value used by every other app
# sharing this VPC (see terraform.module.network).
# network_name = ""

# Optional, defaults to "postgresql0". Must match the value used by every other app
# sharing this Cloud SQL instance (see terraform.module.postgresql).
# postgresql_instance_name = ""

# Optional, defaults to "redis0". Must match the value used by every other app
# sharing this Redis instance (see terraform.module.redis).
# redis_instance_name = ""

# Optional, defaults to 1. Must be unique among apps sharing this Redis instance.
# redis_db = 1
